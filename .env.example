# Environment: development, staging, production
ENVIRONMENT=development
LOG_LEVEL=INFO

# Application
APP_NAME=JobPilot
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=True

# Database (PostgreSQL + pgvector)
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobpilot
# Async connection URL for SQLAlchemy + asyncpg
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot_dev@localhost:5432/jobpilot
# Sync connection URL for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg2://jobpilot:jobpilot_dev@localhost:5432/jobpilot

# Redis Cache & Celery Broker
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# LLM Providers (Active provider: "gemini" or "azure")
LLM_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Azure OpenAI (Enterprise Cloud LLM)
# 1. Endpoint: e.g. https://your-resource-name.openai.azure.com/
# 2. Key: Key from Azure Portal -> Azure OpenAI -> Keys and Endpoint
# 3. Deployment: The custom deployment name you chose in Azure AI Studio (e.g. gpt-4o-mini)
# 4. API Version: Official Azure OpenAI API release (e.g. 2024-08-01-preview or 2024-10-21)
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000"]
